rule TOTAL_event_genomes:
    input:
        Genome = "/scratch/ssd004/datasets/brainemo/Genome/hg38/hg38.fa",
        mic_anno = "data/known_and_novel_microexons.known_microexon_model.hg38.csv",
        total_event_vars = 'CONTROLLED_ACCESS/data/TOTAL_overlaping_variants.SSC_SPARK_MSSNG.csv'
    params:
        sib = "{sib}"
    output:
        out_deltasplice = temp("Results/ASD_sibs/sib_event_genomes/{sib}.deltasplice.fa"),
        #out_pangolin    = temp("Results/ASD_sibs/sib_event_genomes/{sib}.pangolin.fa")
        out_pangolin    = "Results/ASD_sibs/sib_event_genomes/{sib}.pangolin.fa"
    resources:
        get_sib=1
    conda:
        "deltasplice"
    script:
        "scripts/get_sib_event_genomes_TOTAL.py"

rule DeltaSplice_sib:
    input:
        sib = "Results/ASD_sibs/sib_event_genomes/{sib}.deltasplice.fa"
    output:
        out_deltasplice = "Results/ASD_sibs/DeltaSplice/{sib}.deltasplice.csv"
    resources:
        deltasplice=1
    retries: 3
    conda:
        "deltasplice"
    shell:
        """
        python scripts/deltasplice_sib.py \
            --sib_event {input.sib} \
            --output {output.out_deltasplice}
        """
        
rule Pangolin_sib:
    input:
        sib = "Results/ASD_sibs/sib_event_genomes/{sib}.pangolin.fa"
    output:
        out_pangolin = "Results/ASD_sibs/Pangolin/{sib}.pangolin.csv"
    conda:
        "pangolin4"
    shell:
        """
        python scripts/pangolin_sib.py \
            --sib_event {input.sib} \
            --output {output.out_pangolin}
        """
