import csv
import glob
import os
from collections import defaultdict


file_pattern = os.path.join('input_indels4' , '*.indels.tsv')
input_indels = glob.glob(file_pattern)

indel_events = []

# Iterate over the list of file paths
for file_path in input_indels:
    # Extract the filename from the file path
    filename = os.path.basename(file_path)
    # Remove the '.indels.tsv' suffix to get the basename
    if filename.endswith('.indels.tsv'):
        basename = filename[:-len('.indels.tsv')]
        indel_events.append(basename)

print(indel_events)



human_event_coords = dict()

with open("data/known_and_novel_microexons.known_microexon_model.hg38.csv") as file:
    
    reader = csv.DictReader(file, delimiter=",")
    
    for row in reader:
        
        lengthDiff = int(row["lengthDiff"])
        

        chrom = row["chrom"]
        strand = row["strand"] 
        
        C1 = int(row["upIntStart"])
        C2 = int(row["dnIntEnd"])
        ME_start = int(row['upIntEnd'])
        ME_end = int(row['dnIntStart'])
        
        if strand == "-":
            
            C1 = int(row['upIntEnd'])
            C2 = int(row['dnIntStart'])
            ME_start = int(row['dnIntEnd'])
            ME_end = int(row['upIntStart'])
            
        
        human_event_coords[row["event"]] = (C1, C2, ME_start, ME_end-1, chrom, strand, lengthDiff)

discordant_sibs_fam = defaultdict(set)

with open('CONTROLLED_ACCESS/data/SSC_metadata.tsv') as file:
    reader = csv.DictReader(file, delimiter="\t")
    for row in reader:
        if row['Relation'] in ['proband', 'unaffected sibling']:
            discordant_sibs_fam[row['Family ID']].add((row['Sample ID'], row['Affection']))


with open('CONTROLLED_ACCESS/data/SPARK_WGS_metadata.tsv') as file:
    reader = csv.DictReader(file, delimiter="\t")
    for row in reader:
        if row['Relation'] in ['proband', 'sibling']:
            discordant_sibs_fam[row['Family ID']].add((row['Sample ID'], row['Affection']))

discordant_sibs = set([])

for fam in discordant_sibs_fam:

    sib_info = discordant_sibs_fam[fam]
    sib_IDs = [x[0] for x in sib_info]
    affections = [x[1] for x in sib_info]
    
    if '1' in affections and '2' in affections:
        for sample_ID in sib_IDs:
            discordant_sibs.add(sample_ID)

sibs = set()
with open('CONTROLLED_ACCESS/data/SSC_SPARK_variants_TOTAL_delta_genome.csv') as file:

    reader = csv.DictReader(file, delimiter="\t")
    for row in reader:
        sibs.add(row['proband'])
        sibs.add(row['unaffected_sibling'])


sample_IDs = set()
with open('CONTROLLED_ACCESS/data/TOTAL_overlaping_variants.SSC_SPARK_MSSNG.csv') as file:

    reader = csv.DictReader(file, delimiter=",")
    for row in reader:
        sample_IDs.add(row['sample_ID'])

