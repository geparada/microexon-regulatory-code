rule ISM_pangolin:
    input:
        Genome = "/scratch/ssd004/datasets/brainemo/Genome/hg38/hg38.fa",
        mic_anno = "data/known_and_novel_microexons.known_microexon_model.hg38.csv"
    params:
        event = "{event}"
    conda:
        "pangolin4"
    output:
        results = "Results/Pangolin_ISM/{event}.pangolin.ISM.tsv"
    shell:
        """
        python scripts/run_tissue_ISM.py \
            --genome {input.Genome} \
            --mic-anno {input.mic_anno} \
            --event {params.event} \
            --output {output.results}
        """


